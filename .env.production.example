# Production Environment Variables
# Copy this file to .env.production and fill in real values
# NEVER commit .env.production to git

# Database
DATABASE_URL="postgresql://USER:PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/expenseflow?schema=public&sslmode=require"

# NextAuth
NEXTAUTH_URL="https://your-domain.amplifyapp.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Optional: Logging
LOG_LEVEL="info"

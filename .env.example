# Database
# Local: postgresql://postgres:postgres@localhost:5432/expenseflow?schema=public
# Production (RDS): postgresql://USER:PASSWORD@your-rds-endpoint:5432/expenseflow?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expenseflow?schema=public"

# NextAuth
# Local: http://localhost:3000
# Production: https://your-amplify-domain.amplifyapp.com
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Secret - generate a strong random string for production
# openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"
